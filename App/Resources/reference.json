rs joues.","ru":"Слёзы радости текли у них по щекам.","src":"T579387"},{"before":"Cette histoire est basée ","answer":"sur","after":" des faits réels.","ru":"Эта история основана на реальных событиях.","src":"T728249"},{"before":"Il est très difficile de s'entendre ","answer":"avec","after":" lui.","ru":"С ним трудно общаться.","src":"T451579"},{"before":"J'aimerais que vous puissiez venir ","answer":"avec","after":" nous.","ru":"Жаль, что вы не можете с нами пойти.","src":"T477479"},{"before":"Ça, c’était une parade ","answer":"avec","after":" un «P» majuscule.","ru":"Это был парад с большой буквы.","src":"T520424"},{"before":"Je peux désormais jongler ","answer":"avec","after":" quatre balles.","ru":"Я уже четырьмя мячами могу жонглировать.","src":"T915433"},{"before":"Combien de fois ","answer":"par","after":" mois écris-tu à ta mère ?","ru":"Сколько раз в месяц ты пишешь своей матери?","src":"T10335"},{"before":"L'Amérique fut découverte ","answer":"par","after":" Colomb en 1492.","ru":"Америка была открыта Колумбом в 1492 году.","src":"T139257"},{"before":"Normalement, nous avons trois repas ","answer":"par","after":" jour.","ru":"Обычно мы едим три раза в день.","src":"T685568"},{"before":"Je montai ","answer":"par","after":" l'ascenseur au troisième étage.","ru":"Я поднялся на лифте на четвёртый этаж.","src":"T872538"},{"before":"Une vie ","answer":"sans","after":" amour n'a absolument aucun sens.","ru":"Жизнь без любви не имеет вообще никакого смысла.","src":"T3426"},{"before":"Aujourd'hui, le ciel est bleu et ","answer":"sans","after":" nuages.","ru":"Сегодня небо голубое и безоблачное.","src":"T391419"},{"before":"La mesure d'aimer, c'est d'aimer ","answer":"sans","after":" mesure.","ru":"Мерой любви может быть только безмерная любовь.","src":"T450587"},{"before":"Elle aura ","answer":"sans","after":" doute vécu de meilleurs jours.","ru":"Она, несомненно, знавала лучшие времена.","src":"T1468948"},{"before":"Il était tard, donc je suis rentrée ","answer":"chez","after":" moi.","ru":"Было поздно, и я пошла домой.","src":"T1314432"},{"before":"Il me faut être rentrée ","answer":"chez","after":" moi pour minuit.","ru":"Мне надо быть дома к полуночи.","src":"T1973722"},{"before":"Je pense qu'il est temps de rentrer ","answer":"chez","after":" soi.","ru":"Думаю, пора домой.","src":"T2137672"},{"before":"Tom m'a invité ","answer":"chez","after":" lui à sa fête de famille.","ru":"Том пригласил меня к себе на семейное торжество.","src":"T4516207"},{"before":"Il est allé dans les coulisses ","answer":"après","after":" le show.","ru":"Он ушел за кулисы после представления.","src":"T1019773"},{"before":"Personne ne sait ce qui lui est arrivé ","answer":"après","after":".","ru":"Никто не знает, что с ней стало после этого.","src":"T1204128"},{"before":"Rendez-moi le livre ","answer":"après","after":" que vous l'avez lu.","ru":"Верните мне книгу, после того как прочтёте.","src":"T1719923"},{"before":"Il y a un type en bas qui demande ","answer":"après","after":" vous.","ru":"Там внизу вас какой-то мужик спрашивает.","src":"T4196911"},{"before":"L'arbre se courbait ","answer":"sous","after":" le poids des fruits.","ru":"Дерево сгибалось под тяжестью плодов.","src":"T1097420"},{"before":"Il réside ","answer":"sous","after":" le même toit que son ex-femme.","ru":"Они с бывшей женой живут под одной крышей.","src":"T1015968"},{"before":"Je pense que tu devrais vérifier ","answer":"sous","after":" le lit.","ru":"Думаю, тебе стоит проверить под кроватью.","src":"T5301070"},{"before":"Tom était assis ","answer":"sous","after":" un arbre, buvant du vin.","ru":"Том сидел под деревом и пил вино.","src":"T5721299"},{"before":"Les jumeaux sont indifférenciables ","answer":"entre","after":" eux.","ru":"Эти близнецы неотличимы друг от друга.","src":"T433440"},{"before":"Juste ","answer":"entre","after":" nous; es-tu amoureux de ma sœur ?","ru":"Только между нами: ты влюблён в мою сестру?","src":"T874796"},{"before":"Il n'y a pas de mer ","answe